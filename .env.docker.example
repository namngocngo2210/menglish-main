# Mẫu env cho Docker. Sao chép thành .env.production / .env.staging rồi điền giá trị thật.
# production | staging — quyết định tên project Docker (menglish-<env>) và file env được nạp
DEPLOY_ENV=production
APP_NAME="MENGLISH Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://your-domain-or-ip

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# DB_HOST/DB_PORT do docker-compose đặt (db:3306)
DB_CONNECTION=mysql
DB_DATABASE=menglish
DB_USERNAME=menglish
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Cổng DB chỉ mở trên 127.0.0.1 của máy chủ (production 3306, staging 3307)
DB_FORWARD_PORT=3306

SEED_DEFAULT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Đặt true khi đã chạy https
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# File người dùng tải lên: local (trên máy chủ) hoặc r2 (Cloudflare R2). Cách chuyển: docs/chuyen-upload-sang-r2.md
UPLOAD_STORAGE=local
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

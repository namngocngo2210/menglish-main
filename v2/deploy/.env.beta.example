# Sao chép thành v2/deploy/.env.beta (quyền 600, không commit) rồi đổi mật khẩu.
POSTGRES_DB=menglish
POSTGRES_USER=menglish
# Mật khẩu chỉ dùng chữ và số (nằm trong DATABASE_URL), vd. openssl rand -hex 24
POSTGRES_PASSWORD=doimatkhaudaingaunhien
# Cổng Postgres chỉ mở cho 127.0.0.1 trên máy chủ (MariaDB của Laravel đang dùng 3306/3307)
POSTGRES_FORWARD_PORT=5433
# Khóa mã hóa khóa 2FA và dữ liệu nhạy cảm: openssl rand -base64 32. Mất khóa thì mọi người phải bật lại 2FA.
# beta.sh deploy tự tạo nếu chưa có.
APP_ENCRYPTION_KEY=
LOG_LEVEL=info
# Chặn mọi email gửi ra ngoài, kể cả SMTP lưu ở màn Email nhận Ticket (mặc định bật khi MENGLISH_ENV khác production:
# beta chạy trên dữ liệu nhập từ production, có email phụ huynh thật). Đặt false khi cần thử gửi thật.
# MAIL_BLOCK_OUTGOING=true

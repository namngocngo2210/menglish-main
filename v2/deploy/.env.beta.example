# Sao chép thành v2/deploy/.env.beta (quyền 600, không commit) rồi đổi mật khẩu.
POSTGRES_DB=menglish
POSTGRES_USER=menglish
# Mật khẩu chỉ dùng chữ và số (nằm trong DATABASE_URL), vd. openssl rand -hex 24
POSTGRES_PASSWORD=doimatkhaudaingaunhien
# Cổng Postgres chỉ mở cho 127.0.0.1 trên máy chủ (MariaDB của Laravel đang dùng 3306/3307)
POSTGRES_FORWARD_PORT=5433
LOG_LEVEL=info

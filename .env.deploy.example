# ==============================================================================
# MẪU CẤU HÌNH DEPLOY (.env.deploy)
# Hướng dẫn: Sao chép file này thành .env.deploy và điền thông tin máy chủ VPS thực tế.
# File .env.deploy đã được thêm vào .gitignore để không bao giờ bị đẩy lên git.
# ==============================================================================

# SSH connection string đến máy chủ (Ví dụ: user@ip hoặc root@123.45.67.89 hoặc SSH Alias)
DEPLOY_SERVER="user@your-vps-ip"

# Tên miền và thư mục triển khai cho môi trường Portal (Production / Mặc định)
PORTAL_DOMAIN="portal.your-domain.com"
PORTAL_REMOTE_PATH="/var/www/portal.your-domain.com/public_html"

# Tên miền và thư mục triển khai cho môi trường Dùng thử / Staging
STAGING_DOMAIN="dungthu.your-domain.com"
STAGING_REMOTE_PATH="/var/www/dungthu.your-domain.com/public_html"

# Đường dẫn PHP binary trên máy chủ VPS (mặc định 'php' nếu đã có trong PATH hệ thống)
DEPLOY_PHP_BIN="php"

# Phân quyền user:group cho source code trên máy chủ (ví dụ: www-data:www-data, nginx:nginx, cpanel-user:cpanel-user)
DEPLOY_WEB_USER="www-data:www-data"

# Lệnh reload tiến trình PHP / Web server sau khi deploy xong (ví dụ: touch .htaccess hoặc systemctl reload php-fpm)
DEPLOY_RELOAD_CMD="touch .htaccess"

# Nhánh git cần triển khai (mặc định main)
DEPLOY_BRANCH="main"

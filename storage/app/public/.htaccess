# Thư mục chứa file người dùng upload: không bao giờ chạy code ở đây.
# (Phòng thủ nhiều lớp; kiểm tra đuôi file nằm ở SafeUploadService.)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht
Options -ExecCGI -Indexes

<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|cgi|pl|py|sh|html?|svg|js|mjs|htaccess)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
